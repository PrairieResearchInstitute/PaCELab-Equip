<?xml version="1.0" encoding="UTF-8"?>
<!-- The IIS counterpart of .htaccess in this directory. Each server reads one
     and ignores the other, so both ship. Neither helps on nginx, which reads no
     per-directory file: there the deny belongs in the site configuration. -->
<configuration>
  <system.webServer>
    <security>
      <authorization>
        <deny users="*" />
      </authorization>
    </security>
  </system.webServer>
</configuration>
